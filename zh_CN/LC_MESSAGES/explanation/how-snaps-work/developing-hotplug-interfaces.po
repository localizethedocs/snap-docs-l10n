"N: ttyUSB0\n"
"S: serial/by-id/usb-FTDI_FT232R_USB_UART_AH06W0EQ-if00-port0\n"
"S: serial/by-path/pci-0000:02:00.0-usb-0:2.1:1.0-port0\n"
"E: DEVLINKS=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AH06W0EQ-if00-port0 /"
"dev/serial/by-path/pci-0000:02:00.0-usb-0:2.1:1.0-port0\n"
"E: DEVNAME=/dev/ttyUSB0\n"
"E: DEVPATH=/devices/pci0000:00/0000:00:11.0/0000:02:00.0/"
"usb2/2-2/2-2.1/2-2.1:1.0/ttyUSB0/tty/ttyUSB0\n"
"E: ID_BUS=usb\n"
"E: ID_MM_CANDIDATE=1\n"
