#: ../../../reference/interfaces/shared-memory-interface.md:82
msgid "Common issues"
msgstr ""

#: ../../../reference/interfaces/shared-memory-interface.md:84
msgid "Semaphore errors in Python"
msgstr ""

#: ../../../reference/interfaces/shared-memory-interface.md:86
msgid ""
"When using the interface in non-private mode with multi-processing Python, "
"one might encounter something like this:"
msgstr ""

#: ../../../reference/interfaces/shared-memory-interface.md:87
msgid ""
"ProcessPoolExecutor(max_workers=max_workers) as executor:\n"
"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n"
"File \"/opt/python/lib/python3.11/concurrent/futures/process.py\", line 732, "
"in __init__\n"
"self._call_queue = _SafeQueue(\n"
"^^^^^^^^^^^\n"
"File \"/opt/python/lib/python3.11/concurrent/futures/process.py\", line 173, "
"in __init__\n"
"super().__init__(max_size, ctx=ctx)\n"
"File \"/opt/python/lib/python3.11/multiprocessing/queues.py\", line 43, in "
"__init__\n"
"self._rlock = ctx.Lock()\n"
"^^^^^^^^^^\n"
"File \"/opt/python/lib/python3.11/multiprocessing/context.py\", line 68, in "
"Lock\n"
"return Lock(ctx=self.get_context())\n"
"^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n"
"File \"/opt/python/lib/python3.11/multiprocessing/synchronize.py\", line "
"169, in __init__\n"
"SemLock.__init__(self, SEMAPHORE, 1, 1, ctx=ctx)\n"
"File \"/opt/python/lib/python3.11/multiprocessing/synchronize.py\", line 57, "
"in __init__\n"
"sl = self._semlock = _multiprocessing.SemLock(\n"
"^^^^^^^^^^^^^^^^^^^^^^^^^\n"
"PermissionError: [Errno 13] Permission denied`\n"
msgstr ""

#: ../../../reference/interfaces/shared-memory-interface.md:109
msgid ""
"The error comes from Python semaphores attempting to access /dev/shm. To "
"remedy, use private mode instead that bind-mounts a snap-private /dev/shm "
"and then grants access to all of it."
msgstr ""
