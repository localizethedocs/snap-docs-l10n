msgid ""
"Error with the TCG log or some other error detected from the TCG log that is "
"not represented by a more specific error kind."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "`tpm-command-failed`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "An error occurred whilst executing a TPM command."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "`invalid-tpm-response`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
