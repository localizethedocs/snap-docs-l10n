msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid ""
"Problem with the system security that is not represented by a more specific "
"error kind."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid "`tpm-pcr-unusable`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid ""
