msgid "`system-not-efi`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "The current host system is not an EFI system."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "`no-suitable-tpm2-device`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "The device has no suitable TPM2 device."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:176
msgid "`measured-boot`"
msgstr ""

