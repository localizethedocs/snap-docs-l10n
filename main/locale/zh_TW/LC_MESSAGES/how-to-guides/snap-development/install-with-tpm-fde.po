msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid "`sys-prep-applications-present`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid ""
"System preparation applications were detected to be running before the "
"operating system."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid "`absolute-present`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid "Absolute was detected to be executing before the initial OS loader."
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
msgid "`invalid-secure-boot-mode`"
msgstr ""

#: ../../../how-to-guides/snap-development/install-with-tpm-fde.md:96
