#: ../../../reference/development/supported-snap-hooks.md:179
msgid "The prepare-device hook"
msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:181
#: ../../../reference/development/supported-snap-hooks.md:188
msgid "This hook is only supported in gadget snaps."
msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:183
#: ../../../reference/development/supported-snap-hooks.md:190
