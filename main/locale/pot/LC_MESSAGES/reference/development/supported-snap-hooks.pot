msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:163
msgid "The install-device hook"
msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:165
msgid "This hook is supported in Ubuntu Core 20 and subsequent releases."
msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:167
msgid ""
"See [Installation process](https://documentation.ubuntu.com/core/explanation/"
"how-installation-works/#the-install-device-hook) in the Ubuntu Core "
"documentation for more details."
msgstr ""

#: ../../../reference/development/supported-snap-hooks.md:169
