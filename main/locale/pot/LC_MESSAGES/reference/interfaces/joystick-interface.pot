#: ../../../reference/interfaces/joystick-interface.md:2
msgid "joystick interface"
msgstr ""

#: ../../../reference/interfaces/joystick-interface.md:4
msgid "`joystick` allows access to joystick devices."
msgstr ""

#: ../../../reference/interfaces/joystick-interface.md:6
msgid ""
"The interface can access `/dev/input/js*` (with snap version _2.24+_) and `/"
"dev/input/event*` (with snap version _2.33+_) devices that are udev marked "
"with `ID_INPUT_JOYSTICK=1`."
msgstr ""

#: ../../../reference/interfaces/joystick-interface.md:8
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/joystick-interface.md:10
msgid "Requires snapd version _2.24+_."
msgstr ""
