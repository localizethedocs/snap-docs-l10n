#: ../../../reference/interfaces/classic-support-interface.md:0
#: ../../../reference/interfaces/classic-support-interface.md:8
msgid "classic-support interface"
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:10
msgid ""
"The `classic-support` interface sets special permissions for the [classic "
"snap](https://snapcraft.io/classic), effectively giving device ownership to "
"its connected snaps."
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:12
msgid ""
"This interface is intended to be used only with {ref}`Ubuntu Core <ref-"
"glossary_ubuntu-core>`."
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:14
msgid "Requires snapd version _2.23+_."
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:17
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:20
msgid ""
"**{ref}`Auto-connect <explanation-interfaces-interface-auto-connection>`**: "
"no</br> **{ref}`Super-privileged <reference-operations-interfaces-super-"
"privileged-interfaces>`**: yes</br>"
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:20
msgid "</br>"
msgstr ""

#: ../../../reference/interfaces/classic-support-interface.md:24
msgid ""
"The `classic-support` plug is {ref}`unsupported for parallel instances "
"<interfaces-parallel-installs-unsupported>`."
msgstr ""

