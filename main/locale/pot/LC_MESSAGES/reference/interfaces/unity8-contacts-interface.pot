#: ../../../reference/interfaces/unity8-contacts-interface.md:0
#: ../../../reference/interfaces/unity8-contacts-interface.md:8
msgid "unity8-contacts interface"
msgstr ""

#: ../../../reference/interfaces/unity8-contacts-interface.md:10
msgid ""
"`unity8-contacts` enables snaps to access the Unity 8 contacts interface, "
"and consequently, read and change contacts in the Unity 8 global contacts "
"list."
msgstr ""

#: ../../../reference/interfaces/unity8-contacts-interface.md:12
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/unity8-contacts-interface.md:15
msgid ""
"The `unity8-contacts` slot is {ref}`unsupported for parallel instances "
"<interfaces-parallel-installs-unsupported>`. The slot owns a unique system-"
"wide resource that instances would conflict over."
msgstr ""
