#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:2
msgid "snap-interfaces-requests-control interface"
msgstr ""

#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:4
msgid ""
"The `snap-interfaces-requests-control` interface enables the prompting API "
"and its access to prompting-related notice types. This is used internally by "
"snapd to request and manage system resource access."
msgstr ""

#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:8
msgid ""
"See {ref}`Interface management <how-to-guides-work-with-snaps-connect-"
"interfaces>` and {ref}`Supported interfaces <ref-index_interfaces>` for "
"further details on how interfaces are used."
msgstr ""

#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:12
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:14
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/snap-interfaces-requests-control-interface.md:16
msgid ""
"<h3 id='heading--endpoint-access'>Endpoint access permissions</h3>\n"
"<ul>\n"
"<li>/v2/system-info</li>\n"
"<li>/v2/icons/{name}/icon</li>\n"
"<li>/v2/notices</li>\n"
"<li>/v2/notices/{id}</li>\n"
"<li>/v2/snaps/{name}</li>\n"
"<li>/v2/interfaces/requests/prompts</li>\n"
"<li>/v2/interfaces/requests/prompts/{id}</li>\n"
"<li>/v2/interfaces/requests/rules</li>\n"
"<li>/v2/interfaces/requests/rules/{id}</li>\n"
"</ul>\n"
msgstr ""

