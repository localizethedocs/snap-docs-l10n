msgstr ""

#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`docker <interfaces-docker-interface>`"
msgstr ""

#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`docker-support <interfaces-docker-support-interface>`"
