#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`core-support <interfaces-core-support-interface>`"
msgstr ""

#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`cuda-driver-libs <interfaces-cuda-driver-libs>`"
msgstr ""

#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`dbus <interfaces-dbus-interface>`"
msgstr ""

#: ../../../explanation/how-snaps-work/parallel-installs.md:0
msgid "{ref}`desktop <interfaces-desktop-interface>`"
