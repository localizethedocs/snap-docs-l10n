#: ../../../reference/interfaces/pipewire-interface.md:0
#: ../../../reference/interfaces/pipewire-interface.md:8
msgid "pipewire interface"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:10
msgid ""
"The `pipewire` interface allows full access to the user's pipewire socket, "
"for those cases where the available portals are not enough, like when "
"running a snapped desktop environment."
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:12
msgid "**Developer details**"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:14
msgid ""
"**{ref}`Auto-connect <explanation-interfaces-interface-auto-connection>`**: "
"no</br>"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:14
msgid "</br>"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:17
msgid ""
"The `pipewire` slot is {ref}`unsupported for parallel instances <interfaces-"
"parallel-installs-unsupported>`. The slot owns a unique system-wide resource "
"that instances would conflict over."
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:20
msgid "**Path Access**"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:22
msgid ""
"The `pipewire` interface grants read-write access to the following paths:"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:24
msgid "pipewire socket"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:25
msgid "`/run/user/[0-9]*/pipewire-[0-9]` (all systems)"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:26
msgid ""
"`/run/user/[0-9]*/snap.SLOT-PROVIDER-SNAP-NAME/pipewire-[0-9]` (Core systems)"
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:28
msgid "It also offers `shmctl' access."
msgstr ""

#: ../../../reference/interfaces/pipewire-interface.md:30
msgid ""
"The source code for the Pipewire interface is in the snapd repository: "
"[pipewire.go](https://github.com/canonical/snapd/blob/master/interfaces/"
"builtin/pipewire.go)"
msgstr ""

