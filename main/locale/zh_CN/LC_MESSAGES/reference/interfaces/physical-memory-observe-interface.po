#: ../../../reference/interfaces/physical-memory-observe-interface.md:2
msgid "physical-memory-observe interface"
msgstr ""

#: ../../../reference/interfaces/physical-memory-observe-interface.md:4
msgid ""
"`physical-memory-observe ` allows read access the to physical address space "
"via the /dev/mem device."
msgstr ""

#: ../../../reference/interfaces/physical-memory-observe-interface.md:6
msgid ""
"When the kernel is compiled with STRICT_DEVMEM=y (required for certified "
"kernels), accessible memory is an architecture-specific subset for common "
"use cases, such as (eg, X without KMS, DOSBox, etc)."
msgstr ""

#: ../../../reference/interfaces/physical-memory-observe-interface.md:8
msgid ""
"This interface can write to all physical memory when the kernel is compiled "
"with STRICT_DEVMEM=n."
msgstr ""

#: ../../../reference/interfaces/physical-memory-observe-interface.md:10
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/physical-memory-observe-interface.md:12
msgid "Requires snapd version _2.21+_."
msgstr ""
