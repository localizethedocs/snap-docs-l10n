#: ../../../reference/interfaces/raw-usb-interface.md:2
msgid "raw-usb interface"
msgstr ""

#: ../../../reference/interfaces/raw-usb-interface.md:4
msgid ""
"`raw-usb`  allows access to all connected USB devices via a raw interface."
msgstr ""

#: ../../../reference/interfaces/raw-usb-interface.md:6
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/raw-usb-interface.md:8
msgid "Requires snapd version _2.18+_."
msgstr ""

#: ../../../reference/interfaces/raw-usb-interface.md:10
msgid ""
"**NOTE:** The use of this interface only extends the snapd's own sandbox "
"confinement, it will NOT supersede the classic Unix file permission model so "
"the user still needs to have sufficient `r` or `w` permission to the device "
"node by either run the snap command as root or have a designated udev rule "
"that grants the permission."
msgstr ""
