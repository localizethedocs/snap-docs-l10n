#: ../../../reference/interfaces/power-control-interface.md:0
#: ../../../reference/interfaces/power-control-interface.md:8
msgid "power-control interface"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:10
msgid ""
"The `power-control` interface allows the reading and setting of system power "
"settings."
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:12
msgid ""
"This interface is primarily intended to be used with {ref}`Ubuntu Core <ref-"
"glossary_ubuntu-core>`."
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:15
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:17
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:20
msgid ""
"This interface controls a resource shared by the whole system. Snaps that "
"use it can be installed as parallel instances, but every instance acts on "
"the same system resource and snapd does not coordinate between them. Make "
"sure each instance manages different resources, or run only one instance at "
"a time. See {ref}`Snaps that are unsupported as parallel instances "
"<interfaces-parallel-installs-shared-resources>` for details.."
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:23
msgid "This interface enables:"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:24
msgid "reading of all power settings: `/sys/devices/**/power/`"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:26
msgid ""
"setting wake-up events for supported devices: `/sys/devices/**/power/wakeup`"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:28
msgid ""
"configuring power management for supported devices at runtime: `/sys/devices/"
"**/power/control`"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:32
msgid "Code examples"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:34
msgid ""
"The test code can be found in the snapd repository: https://github.com/"
"canonical/snapd/blob/master/interfaces/builtin/power_control_test.go"
msgstr ""

#: ../../../reference/interfaces/power-control-interface.md:36
msgid ""
"The source code for the interface is in the snapd repository: https://"
"github.com/canonical/snapd/blob/master/interfaces/builtin/power_control.go"
msgstr ""
