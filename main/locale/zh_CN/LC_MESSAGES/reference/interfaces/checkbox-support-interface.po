#: ../../../reference/interfaces/checkbox-support-interface.md:0
#: ../../../reference/interfaces/checkbox-support-interface.md:8
msgid "checkbox-support interface"
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:10
msgid ""
"The `checkbox-support` interface is a privileged interface designed for the "
"Canonical checkbox test and certification system. The system is able to run "
"a wide collection of system tests and is thus allowed to execute any command "
"mostly bypassing the sandbox."
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:12
msgid ""
"The interface is allowed to run on both core and classic systems, so that "
"certification can use the same snap across the entire range of devices."
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:14
msgid ""
"**This interface is under development and is not currently available for "
"general use**."
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:16
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:18
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/checkbox-support-interface.md:21
msgid ""
"The `checkbox-support` plug is {ref}`unsupported for parallel instances "
"<interfaces-parallel-installs-unsupported>`."
msgstr ""

