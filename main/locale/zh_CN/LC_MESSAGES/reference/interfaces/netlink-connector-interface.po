#: ../../../reference/interfaces/netlink-connector-interface.md:2
msgid "netlink-connector interface"
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:4
msgid ""
"The `netlink-connector` interface allows communication through the kernel "
"Netlink connector."
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:6
msgid ""
"See also {ref}`netlink-driver <interfaces-netlink-driver-interface>` and "
"{ref}`netlink-audit <interfaces-netlink-audit-interface>`."
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:9
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:11
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:13
msgid ""
"As NETLINK_CONNECTOR is not finely mediated and app-specific, use of this "
"interface allows communications via all Netlink connectors. See [Kernel "
"connector](https://www.kernel.org/doc/Documentation/connector/connector.txt) "
"(on kernel.org) for further details."
msgstr ""

#: ../../../reference/interfaces/netlink-connector-interface.md:15
msgid "Requires snapd version _2.26+_."
msgstr ""

