msgid "Authenticates the snapd user"
msgstr ""

#: ../../../explanation/security/api-authentication-and-authorization.md:0
msgid "System user"
msgstr ""

#: ../../../explanation/security/api-authentication-and-authorization.md:0
msgid "`SO_PEERCRED`, `SOL_SOCKET`"
msgstr ""

#: ../../../explanation/security/api-authentication-and-authorization.md:0
msgid "Authenticates calling system process, user and socket"
msgstr ""

