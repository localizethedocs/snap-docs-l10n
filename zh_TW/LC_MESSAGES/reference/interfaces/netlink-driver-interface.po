#: ../../../reference/interfaces/netlink-driver-interface.md:2
msgid "netlink-driver interface"
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:4
msgid ""
"The `netlink-driver` interface allows a kernel module to expose itself to "
"user-space via the Netlink protocol, typically to transfer information "
"between the kernel and user-space processes."
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:6
msgid ""
"See also {ref}`netlink-audit <interfaces-netlink-audit-interface>` and {ref}"
"`netlink-connector <interfaces-netlink-connector-interface>`."
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:9
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:11
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:13
msgid ""
"Further confinement for particular families/protocols is implemented via "
"Seccomp filtering network Netlink."
msgstr ""

#: ../../../reference/interfaces/netlink-driver-interface.md:15
msgid "Requires snapd version _2.51.1+_."
msgstr ""

