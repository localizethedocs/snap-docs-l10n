msgstr ""

#: ../../../reference/interfaces/storage-framework-service-interface.md:10
msgid ""
"`storage-framework-service` allows operating as, or interacting with, the "
"Storage Framework."
msgstr ""

#: ../../../reference/interfaces/storage-framework-service-interface.md:12
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/storage-framework-service-interface.md:15
