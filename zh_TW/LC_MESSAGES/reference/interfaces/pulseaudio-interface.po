#: ../../../reference/interfaces/pulseaudio-interface.md:0
#: ../../../reference/interfaces/pulseaudio-interface.md:8
msgid "pulseaudio interface"
msgstr ""

#: ../../../reference/interfaces/pulseaudio-interface.md:10
msgid ""
"As of snapd 2.41, this interface is deprecated and the {ref}`audio-playback "
"<interfaces-audio-playback-interface>` and {ref}`audio-record <interfaces-"
"audio-record-interface>` interfaces should be used instead. They provide "
"access to PulseAudio and will provide access to other sound servers in the "
"future."
msgstr ""

#: ../../../reference/interfaces/pulseaudio-interface.md:12
msgid ""
"`pulseaudio` enables access to the PulseAudio sound server for sound "
"playback and recording."
msgstr ""

#: ../../../reference/interfaces/pulseaudio-interface.md:14
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/pulseaudio-interface.md:17
msgid ""
"The `pulseaudio` slot is {ref}`unsupported for parallel instances "
"<interfaces-parallel-installs-unsupported>`. The slot owns a unique system-"
"wide resource that instances would conflict over."
msgstr ""

#: ../../../reference/interfaces/pulseaudio-interface.md:20
msgid ""
"*Note: The {ref}`audio-playback <interfaces-audio-playback-interface>` "
"interface is auto-connected.*"
msgstr ""
