#: ../../../reference/interfaces/dsp-interface.md:0
#: ../../../reference/interfaces/dsp-interface.md:8
msgid "dsp interface"
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:10
msgid ""
"The `dsp` interface allows for the control of digital signal processors "
"(DSPs) on specific devices and systems (such as specific _Ambarella_ devices)"
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:14
msgid "Developer details"
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:16
msgid "**Auto-connect**: no"
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:19
msgid ""
"The `dsp` plug is {ref}`unsupported for parallel instances <interfaces-"
"parallel-installs-unsupported>`. Instances would perform conflicting "
"operations on the same system resources."
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:22
msgid ""
"This interface allows privileged access to hardware and kernel drivers "
"related to the digital signal processor and thus is only allowed on specific "
"devices providing the slot via a gadget and is also not auto-connected."
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:24
msgid "Requires snapd version _2.51+_."
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:26
msgid "<h3 id='heading-code'>Code examples</h3>\n"
msgstr ""

#: ../../../reference/interfaces/dsp-interface.md:28
msgid ""
