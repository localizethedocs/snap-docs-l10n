#: ../../../reference/development/error-responses.md:20
msgid ""
"Conflict errors (409) may be temporary. They are often returned when a new "
"operation on an entity cannot be initiated because a previous operation is "
"still in progress. This might cause new operations on one or more snaps to "
"see errors with the `snap-change-conflict` error kind, for example.  When a "
"conflicting operation completes, new operations may be retried and should "
"later succeed, assuming the completed operation didn't break any dependent "
"state for the new operation."
msgstr ""

#: ../../../reference/development/error-responses.md:22
msgid "Error kinds"
msgstr ""

#: ../../../reference/development/error-responses.md:24
msgid ""
"The following error `kind` values provide extra context on an error response:"
msgstr ""

#: ../../../reference/development/error-responses.md:26
msgid "`app-not-found`: the requested app couldn't be found."
msgstr ""

#: ../../../reference/development/error-responses.md:27
msgid "`assertion-not-found`: assertion can not be found."
msgstr ""

#: ../../../reference/development/error-responses.md:28
msgid "`auth-cancelled`: authentication was cancelled by the user."
msgstr ""

#: ../../../reference/development/error-responses.md:29
msgid "`bad-query`: a bad query was provided."
msgstr ""

#: ../../../reference/development/error-responses.md:30
msgid "`dns-failure`: DNS not responding."
msgstr ""

#: ../../../reference/development/error-responses.md:31
msgid ""
"`insufficient-disk-space`: returned when {ref}`disk space awareness <how-to-"
"guides-manage-snaps-disk-space-awareness>` is enabled and either an install, "
"remove or refresh operation fails due to insufficient free disk space. The "
"error `value`  is an object that contains `snap-names`, an array of affected "
"snaps, and a `change-kind` string with the failed operation."
msgstr ""

#: ../../../reference/development/error-responses.md:32
msgid ""
"`interfaces-unchanged`: the requested interfaces' operation would have no "
"effect."
msgstr ""

#: ../../../reference/development/error-responses.md:33
msgid ""
"`invalid-auth-data`: the authentication data provided failed to validate "
"(e.g. a malformed email address). The `value` of the error is an object with "
"a key per failed field and a list of the failures on each field."
msgstr ""

#: ../../../reference/development/error-responses.md:34
msgid ""
"`login-required`: the requested operation cannot be performed without an "
"authenticated user. This is the kind of any other 401 Unauthorized response."
msgstr ""

#: ../../../reference/development/error-responses.md:35
msgid "`network-timeout`: a timeout occurred during the request."
msgstr ""

#: ../../../reference/development/error-responses.md:36
msgid "`option-not-found`: the given configuration option does not exist."
msgstr ""

#: ../../../reference/development/error-responses.md:37
msgid "`password-policy`: provided password doesn't meet system policy."
msgstr ""

#: ../../../reference/development/error-responses.md:38
msgid "`snap-already-installed`: the requested snap is already installed."
msgstr ""

#: ../../../reference/development/error-responses.md:39
msgid ""
"`snap-architecture-not-available`: no snap revision on specified "
"architecture. Value has the same format as for `snap-channel-not-available`."
msgstr ""

#: ../../../reference/development/error-responses.md:40
msgid ""
"`snap-change-conflict`: the requested operation would conflict with "
"currently ongoing change. This is a temporary error. The error `value` is an "
"object with optional fields `snap-name`, `change-kind` of the ongoing change."
msgstr ""

#: ../../../reference/development/error-responses.md:41
msgid ""
"`snap-channel-not-available`: no snap revision on specified channel. The "
"`value` of the error is a rich object with requested `snap-name`, `action`, "
"`channel`, `architecture`, and actually available `releases` as list of "
"`{\"architecture\":... , \"channel\": ...}` objects."
msgstr ""

#: ../../../reference/development/error-responses.md:42
msgid "`snap-local`: cannot perform operation on local snap."
msgstr ""

#: ../../../reference/development/error-responses.md:43
msgid ""
"`snap-needs-classic`: the requested snap needs classic confinement to be "
"installed."
msgstr ""

#: ../../../reference/development/error-responses.md:44
msgid ""
"`snap-needs-classic-system`: the requested snap can't be installed on the "
"current non-classic system."
msgstr ""

#: ../../../reference/development/error-responses.md:45
msgid "`snap-needs-devmode`: the requested snap needs devmode to be installed."
msgstr ""

#: ../../../reference/development/error-responses.md:46
msgid ""
"`snap-no-update-available`: the requested snap does not have an update "
"available."
msgstr ""

#: ../../../reference/development/error-responses.md:47
msgid ""
"`snap-not-a-snap`: the given snap or directory does not look like a snap."
msgstr ""

#: ../../../reference/development/error-responses.md:48
msgid "`snap-not-classic`: snap not compatible with classic mode."
msgstr ""

#: ../../../reference/development/error-responses.md:49
msgid "`snap-not-found`: the requested snap couldn't be found."
msgstr ""

#: ../../../reference/development/error-responses.md:50
msgid "`snap-not-installed`: the requested snap is not installed."
msgstr ""

#: ../../../reference/development/error-responses.md:51
msgid "`snap-revision-not-available`: no snap revision available as specified."
msgstr ""

#: ../../../reference/development/error-responses.md:52
msgid "`two-factor-failed`: the OTP provided wasn't recognised."
msgstr ""

#: ../../../reference/development/error-responses.md:53
msgid ""
"`two-factor-required`: the client needs to retry the `login` command "
"including an OTP."
msgstr ""

#: ../../../reference/development/error-responses.md:54
msgid "`unsuccessful`: snapctl command was unsuccessful."
msgstr ""

#: ../../../reference/development/error-responses.md:55
msgid "`validation-set-not-found`: the validation set cannot be found."
msgstr ""

#: ../../../reference/development/error-responses.md:56
msgid "`apparmor-prompting-not-running`: AppArmor prompting is not running."
msgstr ""

#: ../../../reference/development/error-responses.md:57
msgid ""
"`interfaces-requests-*`: errors specific to AppArmor prompting client "
"interactions (e.g., so no such rule, rule already exists, etc)."
msgstr ""

