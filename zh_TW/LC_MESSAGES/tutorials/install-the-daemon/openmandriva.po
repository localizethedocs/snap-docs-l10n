#: ../../../tutorials/install-the-daemon/openmandriva.md:2
msgid "Install Snap on OpenMandriva"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:4
msgid ""
"OpenMandriva supplies `snapd` in its repositories. It takes two steps to get "
"it going:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:6
msgid "Install `snapd`:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:8
msgid "sudo dnf install snapd\n"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:12
msgid "Enable `snapd`:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:14
msgid "sudo systemctl enable --now snapd\n"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:18
msgid "Confinement"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:20
msgid ""
"AppArmor is not installed by default on OpenMandriva. It takes the same two "
"steps to install and enable it:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:22
msgid "Install:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:24
msgid "sudo dnf install apparmor\n"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:28
msgid "Enable:"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:30
msgid "sudo systemctl enable apparmor\n"
msgstr ""

#: ../../../tutorials/install-the-daemon/openmandriva.md:34
msgid "Enjoy!"
msgstr ""
